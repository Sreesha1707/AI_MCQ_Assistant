{
  "manifest_version": 3,
  "name": "AI MCQ Assistant",
  "version": "1.0",
  "description": "Generate MCQs from educational webpages using Gemini AI.",

  "permissions": [
    "activeTab",
    "scripting"
  ],

  "host_permissions": [
    "http://localhost:3000/*"
  ],

  "action": {
    "default_popup": "popup.html"
  }
}